# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=

# Endpoints (from docs.gnani.ai, checked 2026-10-27)
PRISMA_URL=https://api.vachana.ai/stt/v3
TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference

# Hard cap on *uncached* API calls across all runs (tracked in data/ledger.jsonl).
# Measured 2026-10-27: ~4 credits per call (25 calls ≈ 100 credits). 300 calls ≈ 1,200 credits.
MAX_API_CALLS=300

# Timbre defaults
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Kaveri
